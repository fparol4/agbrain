    {
      "name": "Authentication",
      "description": "Login establishes the agbrain-session HTTP-only cookie used automatically by subsequent requests.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Login returns the administrator', () => pm.expect(body.user.email).to.eql(pm.environment.get('adminEmail')));",
                  "pm.environment.set('idUser', body.user.idUser);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current session",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/auth/me" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Session returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Session user matches login', () => pm.expect(pm.response.json().user.idUser).to.eql(pm.environment.get('idUser')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Producers",
      "item": [
        {
          "name": "Create producer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "function cpfDigit(values, factor) {",
                  "  const total = values.reduce((sum, value, index) => sum + value * (factor - index), 0);",
                  "  const digit = (total * 10) % 11;",
                  "  return digit === 10 ? 0 : digit;",
                  "}",
                  "const base = String(Date.now()).slice(-9).split('').map(Number);",
                  "const first = cpfDigit(base, 10);",
                  "const second = cpfDigit([...base, first], 11);",
                  "pm.collectionVariables.set('producerDocument', [...base, first, second].join(''));",
                  "pm.collectionVariables.set('producerEmail', `postman.${Date.now()}@example.com`);",
                  "pm.collectionVariables.set('farmName', `Fazenda Postman ${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Producer is created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.environment.set('producerId', body.data.idProducer);",
                  "pm.test('Document is preserved', () => pm.expect(body.data.document).to.eql(pm.collectionVariables.get('producerDocument')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Produtor Postman\",\n  \"documentType\": \"CPF\",\n  \"document\": \"{{producerDocument}}\",\n  \"email\": \"{{producerEmail}}\",\n  \"city\": \"Rio Verde\",\n  \"state\": \"GO\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/producers"
          }
        },
        {
          "name": "List producers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/producers?page=1&limit=20&status=ACTIVE&search=Postman"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Producer list returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('List is paginated', () => pm.expect(pm.response.json()).to.have.keys('data', 'meta'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get producer",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/producers/{{producerId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Producer returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Producer ID matches', () => pm.expect(pm.response.json().data.idProducer).to.eql(pm.environment.get('producerId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update producer",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Produtor Postman Atualizado\",\n  \"city\": \"Jataí\",\n  \"state\": \"GO\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/producers/{{producerId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Producer is updated', () => pm.response.to.have.status(200));",
                  "pm.test('Updated name is returned', () => pm.expect(pm.response.json().data.name).to.eql('Produtor Postman Atualizado'));"
                ]
              }
            }
          ]
        }
      ]
    },
