{
  "info": {
    "_postman_id": "5e2aa25c-1bb5-4e03-97bb-f588973e91bd",
    "name": "AgBrain API",
    "description": "Complete AgBrain API workflow. Run with the AgBrain Local environment. Postman keeps the HTTP-only session cookie automatically. The collection creates its own producer, farm and harvest, validates the main success and error paths, then removes the created data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "producerDocument", "value": "" },
    { "key": "producerEmail", "value": "" },
    { "key": "farmName", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Health returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Database is up', () => pm.expect(pm.response.json().checks.database).to.eql('up'));"
                ]
              }
            }
