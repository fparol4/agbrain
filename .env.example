# Without a domain, replace the IP and keep HTTP mode.
APP_ADDRESS=:80
APP_URL=http://YOUR_VM_PUBLIC_IP
SESSION_SECURE_COOKIE=false

# With a domain, use these three values instead. Caddy provisions HTTPS.
# APP_ADDRESS=agbrain.example.com
# APP_URL=https://agbrain.example.com
# SESSION_SECURE_COOKIE=true

DB_DATABASE=agbrain
DB_USER=agbrain
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

SESSION_COOKIE=agbrain-session
SESSION_TTL_HOURS=8

# Optional localhost-only diagnostic ports.
API_PORT=3334
POSTGRES_PORT=5433
HTTP_PORT=80
HTTPS_PORT=443
